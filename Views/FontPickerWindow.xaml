<Window x:Class="WindowsStickies.Views.FontPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:WindowsStickies.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:locales="clr-namespace:WindowsStickies.Locales"
        xmlns:styles="clr-namespace:WindowsStickies.Styles"
        mc:Ignorable="d"
        WindowStyle="None"
        Background="White"
        Width="280"
        Height="320"
        Title="FontPicker"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="CenterOwner">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="16" ResizeBorderThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid RowDefinitions="Auto, *">

        <views:BaseTitleBarView Grid.Row="0"/>

        <Border Grid.Row="1" Padding="4">
            <Grid RowDefinitions="*, 8, Auto">

                <ListBox Grid.Row="0" ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding SelectedFont}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Source}" FontFamily="{Binding}" FontSize="14"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="2" ColumnDefinitions="*, 4, *">

                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" CornerRadius="{Binding Source={x:Static styles:CornerRadiusHelper.Instance}, Path=ButtonRadius}" Padding="2" ClipToBounds="True">
                        <Grid RowDefinitions="*, *" ColumnDefinitions="*, Auto">
                            <TextBox Grid.RowSpan="2" Grid.Column="0" Text="{Binding SelectedFontSize, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0"/>
                            <RepeatButton Grid.Row="0" Grid.Column="1" Content="▲" FontSize="8" BorderThickness="0, 1, 1, 0" Command="{Binding IncreaseSizeCommand}"/>
                            <RepeatButton Grid.Row="1" Grid.Column="1" Content="▼" FontSize="8" BorderThickness="0, 0, 1, 1" Command="{Binding DecreaseSizeCommand}"/>
                        </Grid>
                    </Border>

                    <Button Grid.Column="2" VerticalAlignment="Stretch" Content="{Binding [FontPickerMenu_Apply], Source={x:Static locales:Localizer.Instance}}" Command="{Binding ApplyCommand}"/>

                </Grid>

            </Grid>
        </Border>

    </Grid>

</Window>
