<Window x:Class="WindowsStickies.Views.HyperlinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:WindowsStickies.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:locales="clr-namespace:WindowsStickies.Locales"
        mc:Ignorable="d"
        WindowStyle="None"
        Background="White"
        Width="480"
        Height="120"
        Title="Hyperlink"
        ResizeMode="NoResize"
        Topmost="True"
        FocusManager.FocusedElement="{Binding ElementName=SearchTextBox}"
        WindowStartupLocation="CenterOwner">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="16" ResizeBorderThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid RowDefinitions="Auto, *">

        <views:BaseTitleBarView Grid.Row="0"/>

        <Border Grid.Row="1" Padding="4">
            <Grid RowDefinitions="*, 4, *, 4,  *">

                <Grid Grid.Row="0">

                    <TextBox x:Name="DisplayTextBox" Text="{Binding DisplayText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="4, 0, 4, 1"/>

                    <TextBlock Text="{Binding [HyperlinkMenu_Placeholder], Source={x:Static locales:Localizer.Instance}}" IsHitTestVisible="False" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                
                                <Setter Property="Visibility" Value="Collapsed"/>
                                
                                <Style.Triggers>
                                    
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=DisplayTextBox}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=DisplayTextBox}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </Grid>

                <Grid Grid.Row="2">

                    <TextBox x:Name="UrlTextBox" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="4, 0, 4, 1"/>

                    <TextBlock Text="URL" IsHitTestVisible="False" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                
                                <Setter Property="Visibility" Value="Collapsed"/>
                                
                                <Style.Triggers>
                                
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=UrlTextBox}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=UrlTextBox}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>

                                </Style.Triggers>
                                
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </Grid>

                <Grid Grid.Row="4"  ColumnDefinitions="*, 4, *">
                    <Button Grid.Column="0" VerticalAlignment="Stretch" Content="{Binding [HyperlinkMenu_Remove], Source={x:Static locales:Localizer.Instance}}" Command="{Binding RemoveCommand}" IsEnabled="{Binding IsEditingExistingLink}"/>
                    <Button Grid.Column="2" VerticalAlignment="Stretch" Content="{Binding [HyperlinkMenu_Apply], Source={x:Static locales:Localizer.Instance}}" Command="{Binding ApplyCommand}"/>
                </Grid>

            </Grid>
        </Border>

    </Grid>

</Window>
