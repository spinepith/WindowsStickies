<Window x:Class="WindowsStickies.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:WindowsStickies.Views"
        xmlns:local="clr-namespace:WindowsStickies"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="None"
        mc:Ignorable="d"
        Width="240"
        Height="240"
        Background="NavajoWhite"
        Title="Stickies"
        Icon="/assets/icon.ico"
        ResizeMode="CanResize"
        Topmost="{Binding TitleBar.IsTopmost}"
        WindowState="{Binding WindowState, Mode=TwoWay}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="16" ResizeBorderThickness="4" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid RowDefinitions="16, *">
        <views:MainView Grid.Row="0" Grid.RowSpan="2" Margin="0, 16, 0, 0"/>
        <views:TitleBarView Grid.Row="0" DataContext="{Binding TitleBar}"/>
    </Grid>

</Window>
