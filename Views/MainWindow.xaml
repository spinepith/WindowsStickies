<Window x:Class="WindowsStickies.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:WindowsStickies.Views"
        xmlns:local="clr-namespace:WindowsStickies"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="None"
        mc:Ignorable="d"
        Width="240"
        Height="240"
        Background="{Binding StickyModel.BackgroundColor}"
        Title="Stickies"
        Icon="/assets/icon.ico"
        ResizeMode="CanResize"
        Topmost="{Binding TitleBar.IsTopmost}"
        WindowState="{Binding WindowState, Mode=TwoWay}">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding TitleBar.NewStickyCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+V" Command=""/>
        <KeyBinding Gesture="Ctrl+D" Command=""/>
        <KeyBinding Gesture="Ctrl+F" Command="{Binding TitleBar.FindCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+T" Command="{Binding TitleBar.ShowAllFontsCommand}"/>
        <KeyBinding Gesture="Ctrl+T" Command=""/>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding TitleBar.SetFontStyleCommand}" CommandParameter="Hyperlink"/>
        <KeyBinding Gesture="Ctrl+OemPlus" Command=""/>
        <KeyBinding Gesture="Ctrl+OemMinus" Command=""/>
        <KeyBinding Gesture="Ctrl+Shift+OemPlus" Command=""/>
        <KeyBinding Gesture="Ctrl+Shift+OemMinus" Command=""/>
        <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding TitleBar.FontColorCommand}"/>
    </Window.InputBindings>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="16" ResizeBorderThickness="4" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid RowDefinitions="16, *">
        <views:MainView Grid.Row="0" Grid.RowSpan="2" Margin="0, 16, 0, 0"/>
        <views:TitleBarView Grid.Row="0" DataContext="{Binding TitleBar}"/>
    </Grid>

</Window>
