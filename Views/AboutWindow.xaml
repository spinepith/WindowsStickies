<Window x:Class="WindowsStickies.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:WindowsStickies.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        WindowStyle="None"
        Background="White"
        Width="320"
        Height="320"
        Title="AboutWindow"
        ResizeMode="NoResize"
        WindowState="{Binding WindowState, Mode=TwoWay}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="16" ResizeBorderThickness="4" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid RowDefinitions="Auto, *">

        <views:BaseTitleBarView Grid.Row="0"/>

        <Grid Grid.Row="1" RowDefinitions="*, 8, *, 8, Auto" HorizontalAlignment="Center" VerticalAlignment="Center">

            <Image Grid.Row="0" Source="/Assets/icon.ico"/>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Stickies" FontSize="16" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding AppVersion}" FontSize="12" Foreground="Black" HorizontalAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Row="4" Text="spinepith" FontSize="12" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>

        </Grid>

    </Grid>

</Window>
