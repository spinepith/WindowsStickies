<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WindowsStickies.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="280"
             d:DesignHeight="240"
             x:Class="WindowsStickies.Views.BaseTitleBarView"
             x:DataType="vm:BaseTitleBarViewModel">

    <Border VerticalAlignment="Top" Background="#40000000" Padding="3, 2">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                
            <Button Width="10" Background="Transparent" Padding="0" Command="{CompiledBinding MinimizeCommand}">
                <Svg Path="/Assets/minimize.svg" Stretch="Uniform"/>
            </Button>
                
            <Button Width="10" Background="Transparent" Padding="0" Command="{CompiledBinding CloseCommand}" CommandParameter="{CompiledBinding $parent[Window]}">
                <Svg Path="/Assets/close.svg" Stretch="Uniform"/>
            </Button>

        </StackPanel>
    </Border>

</UserControl>
