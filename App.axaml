<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WindowsStickies.App"
             xmlns:local="using:WindowsStickies"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <SolidColorBrush x:Key="MenuFlyoutPresenterBackground">#FFFFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="MenuFlyoutSubItemChevron">Black</SolidColorBrush>
        <SolidColorBrush x:Key="MenuFlyoutSubItemChevronPointerOver">Black</SolidColorBrush>
        <SolidColorBrush x:Key="MenuFlyoutSubItemChevronSubMenuOpened">Black</SolidColorBrush>
        <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground">Black</SolidColorBrush>
        <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver">Black</SolidColorBrush>
        <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed">Black</SolidColorBrush>
        <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/GlobalStyles.axaml"/>
    </Application.Styles>
</Application>